#include <windows.h>

// Resource ID 1 so it is the first (and only) icon in the module — GetOverlayInfo
// hands Explorer index 0, which resolves to this.
1 ICON "heart.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Heartmark favourite overlay handler"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "HeartOverlay"
            VALUE "OriginalFilename","HeartOverlay.dll"
            VALUE "ProductName",     "Heartmark"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
